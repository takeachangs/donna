# Higgs Realtime secretary. Never commit the real .env file.
BOSON_API_KEY=

# Optional: silence (ms) before Higgs ends the user's turn. Default 800.
# AGENCY_VAD_SILENCE_MS=800

# Optional: native Codex executable and model. Sign in with Codex separately.
# AGENCY_CODEX_BIN=C:/path/to/codex.exe
# AGENCY_CODEX_MODEL=gpt-6.1-sol

# Optional: Claude Code workers (provider "claude"). Uses the local claude.ai login; ANTHROPIC_API_KEY is removed from the worker env.
# AGENCY_CLAUDE_BIN=C:/path/to/claude.exe
# AGENCY_CLAUDE_MODEL=sonnet

# Optional: engine for workers when the plan does not name one (codex|claude). Unset = Codex when signed in, else Claude Code when signed in.
# AGENCY_DEFAULT_PROVIDER=codex

# Optional: model for Donna's brain, the read-only Claude Code lead session that plans and reviews. Default opus.
# AGENCY_BRAIN_MODEL=opus
