  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/three": "0.162.0",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
